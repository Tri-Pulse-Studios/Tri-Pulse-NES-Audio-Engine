{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build NES Engine",
            "type": "shell",
            "command": "python",
            "args": [
                "${workspaceFolder}/tools/builder.py"
            ],
            "problemMatcher": [
                {
                    "owner": "ca65",
                    "fileLocation": "absolute",
                    "pattern": {
                        "regexp": "^(.*\\.s):(\\d+):\\s+(Error|Warning):\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "severity": 3,
                        "message": 4
                    }
                },
                "$ld65",
                "$ld65-unresolved",
                "$ld65-config"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}