{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build NES Engine",
            "type": "shell",
            "command": "python",
            "args": [
                "${workspaceFolder}/tools/builder.py"
            ],
            "problemMatcher": [
                "$ca65",
                "$ld65",
                "$ld65-unresolved",
                "$ld65-config"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}