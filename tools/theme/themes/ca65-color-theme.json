{
  "$schema": "vscode://schemas/color-theme",
  "name": "CA65 Custom Theme",
  "type": "dark",

  "include": "./dark_plus.json",


  "colors": {
    "editor.background": "#1f1f1f",
    "editor.foreground": "#e0e0e0",
    "editorCursor.foreground": "#FFFFFF",
    "editor.lineHighlightBackground": "#2a2a2a",
    "editor.selectionBackground": "#264f78",
    "editorWhitespace.foreground": "#3b3b3b",
    "editorIndentGuide.background1": "#3b3b3b",
    "editorIndentGuide.activeBackground1": "#707070"

  },
  "tokenColors": [
    {
      "scope": "source.ca65",
      "settings": { "foreground": "#e0e0e0" }
    },
    

    {
      "scope": "string.quoted.double.ca65, string",
      "settings": { "foreground": "#c08060" }
    },

    {
      "scope": "constant.numeric, constant.music",
      "settings": { "foreground": "#D8B45A" }
    },

    {
      "scope": "comment.line.ca65, comment",
      "settings": { "foreground": "#80a060" }
    },


    
    {
      "scope": "variable.label, variable",
      "settings": { "foreground": "#90C8E0" }
    },

    {
      "scope": "keyword.other.opcode.ca65.6502, keyword",
      "settings": { "foreground": "#50a0d0" }
    },

    {
      "scope": "constant.music.pitch_alias, constant.music.rate_alias, constant.music.rest",
      "settings": { "foreground": "#9999FF" }
    },


    {
        "scope": "keyword.other.tp_macros.ca65.code",
        "settings": { "foreground": "#a070d0" }
    },
    {
        "scope": "keyword.other.tp_macros.ca65.music_dsl",
        "settings": { "foreground": "#a070d0" }
    },

    {
        "scope": "keyword.other.tp_macros.ca65.data",
        "settings": { "foreground": "#887898" }
    },
    {
        "scope": "keyword.other.tp_macros.ca65.scaffolding",
        "settings": { "foreground": "#887898" }
    },

    
    {
        "scope": "constant.other.tp_noise.dark_brown",
        "settings": { "foreground": "#997c73" }
    },
    {
        "scope": "constant.other.tp_noise.med_brown",
        "settings": { "foreground": "#a9887d" }
    },
    {
        "scope": "constant.other.tp_noise.light_brown",
        "settings": { "foreground": "#c9aa9f" }
    },


    {
        "scope": "constant.other.tp_noise.dark_russet",
        "settings": { "foreground": "#c07050" }
    },
    {
        "scope": "constant.other.tp_noise.med_russet",
        "settings": { "foreground": "#cc7c54" }
    },
    {
        "scope": "constant.other.tp_noise.light_russet",
        "settings": { "foreground": "#E5A078" }
    },


    {
      "scope": "keyword.control.controlcommand.ca65, keyword.control",
      "settings": { "foreground": "#d090b0" }
    }

  ]
}