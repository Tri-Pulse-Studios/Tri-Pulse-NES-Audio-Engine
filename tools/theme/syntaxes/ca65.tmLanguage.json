{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Tri-Pulse CA65",
	"patterns": [
		{
			"include": "#comments"
		}, 
		{
			"include": "#punctuation"
		}, 
		{
			"include": "#literals"
		},
		{
			"include": "#strings"
		},		
		{
			"include": "#chars"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#opcodes"
		},

		{
			"include": "#tp_macros"
		},

		{
			"include": "#tp_noise"
		},

		{
			"include": "#pseudovars"
		},
		{
			"include": "#pseudofunctions"
		},
		{
			"include": "#controlcommands"
		},
		{
			"include": "#blockstarts"
		},
		{
			"include": "#blockends"
		},
		{
			"include": "#labels"
		}
	],


	"repository": {


		"comments": {
			"patterns": [{
				"name": "comment.line.ca65",
				"match": ";.*$"
			},
			{
				"name": "comment.block.ca65",
				"begin": "\\/\\*",
				"end": "\\*\\/"
			}]
		},
		"punctuation": {
			"patterns": [{
				"name": "punctuation.parenthesis.ca65",
				"match": "\\(|\\)"
			}, {
				"name": "punctuation.separator.ca65",
				"match": ","
			}]
		},

		"literals": {
			"patterns": [{
				"name": "constant.numeric.binary.ca65",
				"match": "%[01]+\\b"	
			}, {
				"name": "constant.numeric.hex.ca65",
				"match": "(\\$[0-9A-Fa-f]+\\b)|\\b([0-9A-Fa-f]+h\\b)"
			}, {
				"name": "constant.numeric.decimal.ca65",
				"match": "\\b[0-9]+\\b"
			}, {	
				"name": "constant.numeric.music.alias.ca65",
				"match": "\\b(8th|qtr|dqt|hlf|dhf|whl|Repeat_xN|Repeat_x1|Repeat_x2|Repeat_x3|Repeat_x4|Repeat_x5|Repeat_x6|Repeat_x7)\\b"
			}, {					

				"name": "constant.numeric.musicname.ca65",
				"match": "\\b([A-G](?:b|s)?[0-5]|rest)\\b"
			}, {
				"name": "constant.language.unnamed-label.ca65",
				"match": ":-+|:\\++"
			}, {
	
				"name": "variable.label",
				"match": "(?<=(?i:jds|jdc|jeq|jne|jmi|jpl|jcc|jcs|jvs|jvc|bcc|bcs|beq|bne|bmi|bne|bpl|bvc|bvs|jmp|jsr|Riff |Riff[^,]*, |Loop[^,]*, |Loop |Repeat |Inc_Page |Channel |Inline ))\\s*(?!\\\")[^\\s\\\"]+"
			}, {
	
				"name": "variable.label",
				"match": "^\\s*\\S*:"
			}]
		},	
		
		
		"strings": {
			"name": "string.quoted.double.ca65",
			"begin": "\"",
			"end": "\"",
			"patterns": [{
				"name": "constant.character.escape.ca65",
				"match": "\\\\."
			}]
		},
		"chars": {
			"patterns": [{
				"name": "string.quoted.single.ca65",
				"match": "'.'"
			}]
		},
		"operators": {
			"patterns": [{
				"name": "keyword.operators.immediate.ca65",
				"match": "#"
			}, {
				"name": "constant.numeric.musicFunc.ca65",
				"match": "(?:\\+Octave|\\-Octave|Octave)"
			}, {	
				"name": "keyword.operators.word.ca65",
				"match": "\\.(?i:mod|bitnot|bitand|bitor|shl|shr|and|or|not|xor)\\b"
			}, {
				"name": "keyword.operators.misc.ca65",
				"match": "=|<>|:=|\\+|-|\\*|/|\\&|~|\\||<<|>>|\\&\\&|\\|\\||!|<|>|<=|>="	
			}]
		},

		"opcodes": {
			"patterns": [
				{
					"comment": "Official 6502 Opcodes",
					"name": "keyword.other.opcode.ca65.6502",
					"match": "\\b(?i:adc|and|asl|bcc|bcs|beq|bit|bmi|bne|bpl|brk|bvc|bvs|clc|cli|clv|cmp|cpx|cpy|dec|dex|dey|eor|inc|inx|iny|jmp|jsr|lda|ldx|ldy|lsr|nop|ora|pha|php|pla|plp|rol|ror|rti|rts|sbc|sec|sei|sta|stx|sty|tax|tay|tsx|txa|txs|tya)\\b"
				}
			]
		},


		"tp_macros": {
			"patterns": [
				{
					"comment": "Music Scaffolding Macros",
					"name": "keyword.other.tp_macros.ca65.scaffolding",
					"match": "\\b(Channel|Header|Noise_Header|Loop|Inc_Page)\\b"
				},
				{
					"comment": "Code Macros",
					"patterns": [
						{
							"comment": "Math",
							"name": "keyword.other.tp_macros.ca65.code",
							"match": "\\b(asr|add|sub)\\b"
						},
						{
							"comment": "Repeated Instructions",
							"name": "keyword.other.tp_macros.ca65.code",
							"match": "\\b(lsrn|rorn|asln|roln|deyn|inyn|dexn|inxn)\\b"
						},
						{
							"comment": "Stack",
							"name": "keyword.other.tp_macros.ca65.code",
							"match": "\\b(phaxy|plaxy|phx|plx|phy|ply|phm|plm)\\b"
						},
						{
							"comment": "Naming",
							"name": "keyword.other.tp_macros.ca65.code",
							"match": "\\b(Inline|name_cache|name_tmp|clear_tmp|clear_cache|Res_RAM|Res_5_Channels)\\b"
						},
						{
							"comment": "Branching",
							"name": "keyword.other.tp_macros.ca65.code",
							"match": "\\b(bal|jeq|jne|jmi|jpl|jcs|jcc|jvs|jvc|bds|bdc|jds|jdc)\\b"
						},
						{
							"comment": "Debugging",
							"name": "keyword.other.tp_macros.ca65.code",
							"match": "\\b(Runtime_Exception)\\b"
						}
					]
				},
				{
					"comment": "Music DSL Instructions Macros",
					"patterns": [
						{
							"comment": "Notes",
							"name": "keyword.other.tp_macros.ca65.music_dsl",
							"match": "\\b(Notes)\\b"
						},
						{
							"comment": "Compression",
							"name": "keyword.other.tp_macros.ca65.music_dsl",
							"match": "\\b(If_Alt|Riff|Repeat|Duration)\\b"
						},
						{
							"comment": "Engine State",
							"name": "keyword.other.tp_macros.ca65.music_dsl",
							"match": "\\b(Set_Pitch|Shift_Pitch|Set_Env|Set_Env_Bank)\\b"
						},
						{
							"comment": "Miscellaneous",
							"name": "keyword.other.tp_macros.ca65.music_dsl",
							"match": "\\b(Vol_Fade_In|Vol_Fade_Out|Set_Volume)\\b"
						},
						{
							"comment": "Macro Subroutines",
							"name": "keyword.other.tp_macros.ca65.music_dsl.subroutine",
							"match": "\\b(Define_Pitches|Sub_Note|Assert_Valid_Pitch|Set_Pitch_Data|Sub_Repeat|Sub_Duration|Sub_Pair_Duration|Sub_Shift_Pitch)\\b"
						}
					]
				},
				{
					"comment": "Music Data Macros",
					"patterns": [
						{
							"comment": "Sound Effects",
							"name": "keyword.other.tp_macros.ca65.data",
							"match": "\\b(SFX|NoiseFX|NB_Validate|Kick_Type)\\b"
						},
						{
							"comment": "Envelopes",
							"name": "keyword.other.tp_macros.ca65.data",
							"match": "\\b(Env|Env_Bank|Vibrato_Delay|Vibrato_Cycle)\\b"
						},
						{
							"comment": "Misc",
							"name": "keyword.other.tp_macros.ca65.data",
							"match": "\\b(Song|Duration_Set|MiscFX)\\b"
						},
						{
							"comment": "Data Output",
							"name": "keyword.other.tp_macros.ca65.data.output",
							"match": "\\b(Output_Song_Pointers|Output_SFX|Output_NoiseFX|Output_Kick_Type|Output_Env|Output_Vibrato_Delays|Output_Vibrato_Cycles|Output_Duration_Sets|Output_MiscFX_Data)\\b"
						},
						{
							"comment": "Macro Subroutines",
							"name": "keyword.other.tp_macros.ca65.data.subroutine",
							"match": "\\b(Sub_SFX|Sub_Env|Sub_Vibrato_Cycle|Sub_Duration_Set|Dur_Opcode_Calc)\\b"
						}
					]
				}


			]
		},
		
		"tp_noise": {
			"patterns": [
				{
					"comment": "Dark Brown",
					"name": "constant.other.tp_noise.dark_brown",
					"match": "\\b(Crash|Tamb)_[0-9a-f](?=_|\\b)"
				},
				{
					"comment": "Medium Brown",
					"name": "constant.other.tp_noise.med_brown",
					"match": "\\b(Rasp|Shaker)_[0-9a-f](?=_|\\b)"
				},
				{
					"comment": "Light Brown",
					"name": "constant.other.tp_noise.light_brown",
					"match": "\\bHat_[0-9a-f](?=_|\\b)"
				},

				
				{
					"comment": "Dark Russet",
					"name": "constant.other.tp_noise.dark_russet",
					"match": "\\b(Wash|Timpani)_[0-9a-f](?=_|\\b)"
				},
				{
					"comment": "Medium Russet",
					"name": "constant.other.tp_noise.med_russet",
					"match": "\\bSnare_[0-9a-f](?=_|\\b)"
				},
				{
					"comment": "Light Russet",
					"name": "constant.other.tp_noise.light_russet",
					"match": "\\bCymbal_[0-9a-f](?=_|\\b)"
				}
			]
		},


		"pseudovars": {
			"patterns": [{
				"name": "keyword.control.pseudovar.ca65",
				"match": "\\.?(?i:cpu|paramcount|time|version)\\b"
			}]
		},
		"pseudofunctions": {
			"patterns": [{
				"name": "keyword.control.pseudofunction.ca65",
				"match": "\\.(?i:bankbyte|blank|concat|const|hibyte|hiword|ident|left|lobyte|loword|match|mid|ref|referenced|right|sizeof|strat|sprintf|string|strlen|tcount|xmatch)\\b"
			}]
		},
		"controlcommands": {
			"patterns": [{
				"name": "keyword.control.controlcommand.ca65",
				"match": "\\.(?i:a16|a8|addr|align|asciiz|assert|autoimport|bankbytes|bss|byt|byte|case|charmap|code|condes|constructor|data|dbyt|debuginfo|define|def|defined|definedmacro|destructor|dword|else|elseif|end|endif|endrep|endrepeat|error|exitmac|exitmacro|export|exportzp|fatal|faraddr|feature|fileopt|fopt|forceimport|global|globalzp|hibytes|i16|i8|if|ifblank|ifconst|ifdef|ifnblank|ifndef|ifnref|ifp02|ifp816|ifpc02|ifpsc02|ifref|import|importzp|incbin|include|interruptor|linecont|list|listbytes|lobytes|local|localchar|macpack|org|out|p02|p816|pagelen|pagelength|pc02|popseg|psc02|pushseg|reloc|repeat|res|rodata|segment|setcpu|smart|sunplus|tag|undef|undefine|warning|word|zeropage)\\b"
			}]
		},
		"blockstarts": {
			"patterns": [{
				"name": "keyword.control.block.ca65",
				"contentName": "entity.name.function.ca65",
				"begin": "\\.(?i:enum|macro|mac|proc|scope|struct)\\s*",
				"end": "\\s"
			}]
		},
		"blockends": {
			"patterns": [{
				"name": "keyword.control.block.ca65",
				"match": "\\.(?i:endenum|endmacro|endmac|endproc|endscope|endstruct)\\b"
			}]
		},
		"labels": {
			"patterns": [{
				"name": "variable.ca65",
				"match": "^\\s*\\S*:"
			}]
		}
	},
	"scopeName": "source.ca65"
}
